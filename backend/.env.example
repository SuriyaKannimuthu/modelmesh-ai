APP_ENV=development

DATABASE_URL=postgresql+psycopg://modelmesh:modelmesh@localhost:5432/modelmesh
REDIS_URL=redis://localhost:6379/0

# JSON list of origins allowed to call the API (the Next.js dev server by default)
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Providers. A provider is enabled only when its settings below are filled in.
# List values are JSON arrays. Clients address models as "provider/model".
# ---------------------------------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=120

# Offline echo provider ("mock/echo"); no key needed. Disable in production.
ENABLE_MOCK_PROVIDER=true

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=["claude-opus-5-5","claude-sonnet-5-5","claude-haiku-5-5"]
# ANTHROPIC_MAX_TOKENS=16000

# OpenAI: needs both a key and at least one model
OPENAI_API_KEY=
OPENAI_MODELS=[]
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local, OpenAI-compatible): e.g. OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODELS=[]

OTEL_SERVICE_NAME=modelmesh-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
